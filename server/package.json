{
  "name": "resolvehq-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../.prettierignore .",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
